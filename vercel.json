{
  "version": 2,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*).(jpg|jpeg|png|svg|webp|pdf|css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "functions": {
    "api/chat.js": {
      "includeFiles": "knowledge/**",
      "maxDuration": 30,
      "memory": 256
    },
    "api/health.js": {
      "maxDuration": 10,
      "memory": 128
    }
  }
}
