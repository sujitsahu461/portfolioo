# ===== Sujit AI Environment Variables =====
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# --- LLM Provider ---
# OpenAI API key (required for embeddings + chat completion)
OPENAI_API_KEY=sk-your-openai-api-key-here

# LLM model to use for chat completions
LLM_MODEL=gpt-4o-mini

# Embedding model
EMBEDDING_MODEL=text-embedding-3-small

# --- Vector Database (Qdrant Cloud) ---
# Get free tier at https://cloud.qdrant.io
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key-here
QDRANT_COLLECTION=sujit-ai

# --- Security ---
# Admin API key for protected endpoints (ingest, reindex)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=generate-a-strong-random-key-here

# --- Rate Limiting ---
# Maximum requests per IP per minute
RATE_LIMIT_MAX=10
# Maximum message length (characters)
MAX_MESSAGE_LENGTH=500
